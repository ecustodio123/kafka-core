{
  "name": "kafka-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "configure:culqi-test": "node scripts/configure-culqi-test-settings.mjs",
    "test:create-order": "node --test scripts/create-order.integration.test.mjs",
    "test:create-order:unit": "npx -y deno@latest test --allow-env supabase/functions/create-order/index_test.ts",
    "test:create-payment-attempt:mock": "node --test scripts/create-payment-attempt.mock.test.mjs",
    "test:create-payment-attempt:mock:unit": "npx -y deno@latest test --allow-env supabase/functions/create-payment-attempt/index_test.ts",
    "test:complete-payment-3ds:unit": "npx -y deno@latest test --allow-env supabase/functions/complete-payment-3ds/index_test.ts",
    "test:payments:3c2:flow": "npx -y deno@latest test --allow-env supabase/functions/payments_3c2_flow_test.ts",
    "test:payments:3ds:rpc-contract": "node --test scripts/payment-3ds-rpc.contract.test.mjs",
    "test:payments:source:rpc-contract": "node --test scripts/payment-attempt-source.contract.test.mjs",
    "test:payments:uncertainty:sql": "node --test scripts/payment-uncertainty.sql.test.mjs",
    "test:payments:reconciliation:sql": "node --test scripts/payment-reconciliation.sql.test.mjs",
    "test:payments:claim-hardening:sql": "node --test scripts/payment-claim-hardening.sql.test.mjs",
    "test:payments:session-claim:sql": "node --test scripts/payment-session-claim.sql.test.mjs",
    "test:get-order-payment-status:unit": "npx -y deno@latest test --allow-env supabase/functions/get-order-payment-status/index_test.ts",
    "test:reconcile-payment-attempt:unit": "npx -y deno@latest test --no-lock --allow-env supabase/functions/reconcile-payment-attempt/index_test.ts",
    "test:payments:evidence:unit": "npx -y deno@latest test --no-lock supabase/functions/_shared/culqi-test-evidence_test.ts",
    "test:get-payment-config": "node --test scripts/get-payment-config.integration.test.mjs",
    "test:payment-claim": "node --test scripts/payment-claim.integration.test.mjs",
    "test:payment-attempts": "node --test scripts/payment-attempts.integration.test.mjs",
    "migrate:category-images": "node scripts/migrate-category-images.mjs",
    "migrate:product-images": "node scripts/migrate-product-images.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
